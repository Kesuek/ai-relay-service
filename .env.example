# AI-Relay-Service docker compose — example environment.
# Copy to `.env`, fill in values, and keep `.env` OUT of git (it is ignored).
#   cp .env.example .env

# --- Master admin seed (REQUIRED for a stable install) ---------------------
# Deterministic master admin seed. Pin it here so it survives container
# rebuilds; it is stored (hashed) in the DB on first start. Generate once:
#   python -c "import secrets; print('adm_' + secrets.token_urlsafe(32))"
RELAY_MASTER_SEED=adm_change_me_generate_a_random_one

# --- Backend selection ------------------------------------------------------
# sqlite (default, DB file in the relay-data volume) or postgres.
# For postgres: run `docker compose --profile postgres up -d`.
RELAY_DB_TYPE=sqlite
RELAY_PG_DSN=

# --- Postgres (only used when RELAY_DB_TYPE=postgres) ----------------------
# The relay reaches the DB container on the compose network via the hostname
# `postgres` (NOT localhost). The DSN and POSTGRES_PASSWORD must match.
#
# Minimal Postgres setup — use the SAME password in both places:
#   RELAY_DB_TYPE=postgres
#   RELAY_PG_DSN=postgresql+psycopg://relay:MEIN_PASSWORT@postgres:5432/relay
#   POSTGRES_USER=relay
#   POSTGRES_PASSWORD=MEIN_PASSWORT
#   POSTGRES_DB=relay
#
# NOTE: POSTGRES_PASSWORD defaults to "relay" (no required marker) so the
# default sqlite build stays green. If you use the postgres profile and set a
# password here, put the same value in RELAY_PG_DSN.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# --- Session secret ----------------------------------------------------------
# Used to sign dashboard session cookies. Provide a stable >=32-char value.
RELAY_SESSION_SECRET=

# Set to false when serving over plain http (LAN/NAS without TLS).
RELAY_SESSION_COOKIE_SECURE=false
