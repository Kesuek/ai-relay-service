# AI-Relay-Service docker compose — example environment.
# Copy to `.env` in the repo root, fill in values, and keep `.env` OUT of git
# (it is ignored). Run from the repo root:
#   cp docker/server/.env.example .env

# --- Master admin seed (REQUIRED for a stable install) ---------------------
# Deterministic master admin seed. Pin it here so it survives container
# rebuilds; it is stored (hashed) in the DB on first start. Generate once:
#   python -c "import secrets; print('adm_' + secrets.token_urlsafe(32))"
RELAY_MASTER_SEED=adm_change_me_generate_a_random_one

# --- Backend selection ------------------------------------------------------
# sqlite (default, DB file in the relay-data volume) or postgres.
# For postgres: run `docker compose --profile postgres up -d`.
RELAY_DB_TYPE=sqlite
RELAY_PG_DSN=

# --- Postgres (only used when RELAY_DB_TYPE=postgres) ----------------------
# Postgres can be an EXTERNAL database on another host, or the bundled
# `postgres` container (--profile postgres).
#
# Option A — external Postgres on another host (no postgres service needed):
#   RELAY_DB_TYPE=postgres
#   RELAY_PG_DSN=postgresql+psycopg://relay:MEIN_PASSWORT@192.168.1.50:5432/relay
#   # POSTGRES_* are NOT used here — the password lives in the DSN.
#
# Option B — bundled postgres container (--profile postgres):
#   RELAY_DB_TYPE=postgres
#   RELAY_PG_DSN=postgresql+psycopg://relay:<POSTGRES_PASSWORD>@postgres:5432/relay
#   POSTGRES_USER=relay
#   POSTGRES_PASSWORD=<POSTGRES_PASSWORD>   # must match the DSN password
#   POSTGRES_DB=relay
#
# NOTE: POSTGRES_PASSWORD defaults to "relay" (no required marker) so the
# default sqlite build stays green. Replace it with a real password for
# postgres deployments.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay

# --- Session secret ----------------------------------------------------------
# Used to sign dashboard session cookies. Provide a stable >=32-char value.
RELAY_SESSION_SECRET=

# Set to false when serving over plain http (LAN/NAS without TLS).
RELAY_SESSION_COOKIE_SECURE=false

# --- TLS (optional, T-111) ---------------------------------------------------
# Serve HTTPS by setting both cert + key. Paths are container-side; the certs
# directory is mounted read-only at /certs (RELAY_TLS_CERTS_DIR).
#   RELAY_TLS_CERTS_DIR=./certs
#   RELAY_TLS_CERTFILE=/certs/fullchain.pem
#   RELAY_TLS_KEYFILE=/certs/privkey.pem
# Leave empty to serve plain http.
RELAY_TLS_CERTS_DIR=./certs
RELAY_TLS_CERTFILE=
RELAY_TLS_KEYFILE=
